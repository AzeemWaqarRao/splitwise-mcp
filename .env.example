# Copy to .env and fill in. Get the API key at https://dev.splitwise.com → "Your apps".
SPLITWISE_API_KEY=your_api_key_here

# Optional: a default group id so you don't have to pass it on every call.
# Find it in the Splitwise URL for a group, or via the get_groups API.
SPLITWISE_GROUP_ID=your_default_group_id
